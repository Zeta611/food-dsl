{
  "name": "ui",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm:dev:elm\" \"pnpm:dev:vite\"",
    "dev:elm": "elm-live src/Main.elm --no-server -- --output=public/elm.js --debug",
    "dev:vite": "vite",
    "typecheck": "tsc --noEmit",
    "build:elm": "elm make src/Main.elm --output=public/elm.js --debug",
    "build": "pnpm build:elm && vite build",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "Jay Lee <jay.lee@cs.berkeley.edu> (https://jaylee.pl/)",
  "license": "BSD-3-Clause",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "elm-live": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
